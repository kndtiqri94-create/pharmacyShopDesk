# Copy to .env for local development. Never commit real values (secrets stay outside the code).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# PostgreSQL connection string (required when STORE=postgres)
DATABASE_URL=postgresql://shopdesk:change-me@localhost:5432/shopdesk?schema=public
# Static bearer token guarding /api/v1 until production auth (F-3.5) replaces it.
# Required unless ALLOW_INSECURE_DEV=true; min 32 chars in production. Generate: openssl rand -hex 32
API_AUTH_TOKEN=
# Development only: run without a token. Refused when NODE_ENV=production.
ALLOW_INSECURE_DEV=false
# Comma-separated browser origins allowed by CORS (the PWA origin). Empty = no cross-origin access.
CORS_ORIGINS=http://localhost:4200
# Reject plain HTTP (honours X-Forwarded-Proto from the reverse proxy). Always on in production.
REQUIRE_HTTPS=false
# Use the in-memory store instead of PostgreSQL (development and tests only).
STORE=postgres
